<Window x:Class="AntSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Симулятор муравья"
        Height="750" Width="1050"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F3F6" Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель настроек -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,15,0">

                <TextBlock Text="Симулятор муравья"
                           FontSize="23"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Размер поля -->
                <GroupBox Header="Размер игрового поля"
                          Padding="10"
                          Margin="0,0,0,12">

                    <StackPanel>
                        <TextBlock Text="Ширина (клетки)"/>
                        <TextBox x:Name="WidthBox"
                                 Text="30"
                                 Margin="0,5,0,10"/>

                        <TextBlock Text="Высота (клетки)"/>
                        <TextBox x:Name="HeightBox"
                                 Text="20"
                                 Margin="0,5,0,10"/>

                        <Button Content="Сгенерировать поле"
                                Height="35"
                                Click="Generate_Click"/>
                    </StackPanel>
                </GroupBox>

                <!-- Правила -->
                <GroupBox Header="Правила поведения"
                          Padding="10"
                          Margin="0,0,0,12">

                    <StackPanel>

                        <TextBlock Text="Если клетка БЕЛАЯ:"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="WhiteRuleBox"
                                  SelectedIndex="0"
                                  Margin="0,5,0,12">

                            <ComboBoxItem Content="Повернуть направо"/>
                            <ComboBoxItem Content="Повернуть налево"/>
                            <ComboBoxItem Content="Идти прямо"/>
                            <ComboBoxItem Content="Перекрасить клетку"/>

                        </ComboBox>

                        <TextBlock Text="Если клетка ЧЁРНАЯ:"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="BlackRuleBox"
                                  SelectedIndex="1"
                                  Margin="0,5,0,0">

                            <ComboBoxItem Content="Повернуть направо"/>
                            <ComboBoxItem Content="Повернуть налево"/>
                            <ComboBoxItem Content="Идти прямо"/>
                            <ComboBoxItem Content="Перекрасить клетку"/>

                        </ComboBox>

                    </StackPanel>
                </GroupBox>

                <!-- Управление -->
                <GroupBox Header="Управление" Padding="10">

                    <StackPanel>
                        <Button Content="Запустить"
                                Height="38"
                                Margin="0,0,0,8"
                                Click="Start_Click"/>

                        <Button Content="Пауза"
                                Height="38"
                                Margin="0,0,0,8"
                                Click="Pause_Click"/>

                        <Button Content="Один шаг"
                                Height="38"
                                Click="Step_Click"/>
                    </StackPanel>

                </GroupBox>

                <TextBlock x:Name="StatusText"
                           Text="Шагов: 0"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,15,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Игровое поле -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Игровое поле"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                    <Canvas x:Name="GameCanvas"
                            Background="#DDDDDD"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                </ScrollViewer>
            </Grid>

        </Border>

    </Grid>
</Window>
